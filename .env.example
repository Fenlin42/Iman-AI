# Kopiere diese Datei nach .env, wenn du etwas einstellen willst.

# Nur fuer den automatischen Modus. Leer lassen = Kopier-Modus (keine API-Kosten).
ANTHROPIC_API_KEY=

# Modell fuer alle KI-Schritte.
ANTHROPIC_MODEL=claude-opus-5-5

# Passwort fuer die Oberflaeche. Lokal optional, auf Render Pflicht.
APP_PASSWORD=

# Ablageort der SQLite-Datenbank.
DATA_DIR=./data

# 1 = ohne API-Key mit Beispieltexten testen.
MOCK_AI=0
